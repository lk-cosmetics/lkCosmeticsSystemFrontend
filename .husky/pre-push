#!/bin/sh
echo "🚀 Running pre-push checks..."

# Check if any source files changed since last push
CHANGED_FILES=$(git diff --name-only @{push}..HEAD 2>/dev/null || git diff --name-only HEAD~1..HEAD)
SOURCE_CHANGED=$(echo "$CHANGED_FILES" | grep -E '\.(ts|tsx|js|jsx|json)$' || true)

if [ -z "$SOURCE_CHANGED" ]; then
  echo "📦 No source files changed, skipping checks"
  exit 0
fi

echo "📦 Source files changed, running full codebase checks..."

# Step 1: Run Prettier to auto-format
echo "💅 Running Prettier to auto-format code..."
npm run format:all
if [ $? -ne 0 ]; then
  echo "❌ Prettier formatting failed!"
  exit 1
fi
echo "✅ Code formatted successfully!"

# Step 2: Check if there are any changes after auto-fixes
CHANGES_AFTER_FIX=$(git diff --name-only)
if [ -n "$CHANGES_AFTER_FIX" ]; then
  echo "📝 Auto-fixes were applied. Staging changes..."
  git add .
  echo "✨ Changes have been staged. You may want to review them before pushing."
fi

# Step 3: Run TypeScript type checking
echo "🔍 Running TypeScript type check..."
npm run type-check
if [ $? -ne 0 ]; then
  echo "❌ TypeScript type check failed! Please fix type errors before pushing."
  exit 1
fi
echo "✅ TypeScript type check passed!"

# Step 4: Run build
echo "🏗️  Running build..."
npm run build
if [ $? -ne 0 ]; then
  echo "❌ Build failed! Please fix build errors before pushing."
  exit 1
fi
echo "✅ Build check passed!"

echo "🎉 All pre-push checks passed successfully!"
